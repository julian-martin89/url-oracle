# Copy this file to .env and fill in the values before running.
# Unlike most values below, RECIPIENT_WALLET and the CDP_API_KEY_* pair have
# no safe placeholder — the x402 resource server authenticates against the
# real CDP facilitator on every boot, dev included. `npm run dev` will not
# start without real values for those three.

# ---- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- x402 monetization ------------------------------------------------------
# Wallet address (Base L2, EVM format) that receives USDC micropayments.
# Never custodied by CDP — CDP's facilitator only verifies and settles the
# client's signed payment authorization; funds go straight here on-chain.
RECIPIENT_WALLET=0xYourWalletAddressHere

# Optional: also accept payment on Solana mainnet. When set, every x402
# challenge offers this alongside Base. Leave unset to offer Base only.
# SOLANA_RECIPIENT_WALLET=YourSolanaWalletAddressHere

# CDP (Coinbase Developer Platform) API credentials — create a project at
# https://portal.cdp.coinbase.com/, generate an API key, and put the two
# halves here. These authenticate calls to CDP's hosted x402 facilitator,
# which also makes verify_url auto-discoverable in the x402 Bazaar.
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Optional: URLhaus (abuse.ch) Auth-Key for the known-malicious-URL check.
# Free — sign up at https://auth.abuse.ch/ and generate one from your
# profile. Without it, verify_url still runs (RDAP + brand-similarity),
# just without the threat-intel signal.
# URLHAUS_AUTH_KEY=your-urlhaus-auth-key

# Price per verify_url call once the free tier is exhausted, in atomic
# USDC units (USDC has 6 decimals). 3000 = $0.003.
PRICE_ATOMIC_USDC=3000

# Number of free calls granted per wallet/IP before the x402 gate kicks in.
FREE_TIER_LIMIT=5

# ---- Rate-limit / freemium counter (in-memory LRU) -------------------------
RATE_LIMIT_CACHE_MAX_ENTRIES=50000
RATE_LIMIT_CACHE_TTL_MS=86400000

# ---- Oracle tuning ----------------------------------------------------------
UPSTREAM_TIMEOUT_MS=8000
NEW_DOMAIN_THRESHOLD_DAYS=30
BRAND_SQUAT_MAX_DISTANCE=2
